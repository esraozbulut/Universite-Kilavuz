{
  "Serilog": {
    "Using": [ "Serilog.Sinks.MSSqlServer" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "MSSqlServer",
        "Args": {
          "connectionString": "DefaultConnection",
          "sinkOptionsSection": {
            "tableName": "AuditLogs",
            "autoCreateSqlTable": true
          },
          "columnOptionsSection": {
            "customColumns": [
              { "ColumnName": "UserId", "DataType": "int", "AllowNull": true },
              { "ColumnName": "IPAddress", "DataType": "nvarchar", "DataLength": 100, "AllowNull": true },
              { "ColumnName": "RequestPath", "DataType": "nvarchar", "DataLength": 255, "AllowNull": true },
              { "ColumnName": "ActionType", "DataType": "nvarchar", "DataLength": 100, "AllowNull": true }
            ]
          }
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Logging": {
    "PanelRoutePrefix": "/Panel"
  },
  "AllowedHosts": "*",
  "FileStorage": {
    "MaxFileSizeMb": 10
  }
}
