<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | Kurumsal Kılavuz</title>

    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/font-awesome/css/font-awesome.css" rel="stylesheet">
    <link href="~/css/animate.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="top-navigation">
    <div id="wrapper">
        <div id="page-wrapper" class="gray-bg">
            <div class="row border-bottom white-bg">
                <nav class="navbar navbar-expand-lg navbar-static-top" role="navigation">
                    <a href="/" class="navbar-brand">KILAVUZ</a>
                    <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbar" aria-expanded="false" aria-label="Toggle navigation">
                        <i class="fa fa-reorder"></i>
                    </button>
                    <div class="navbar-collapse collapse" id="navbar">
                        <ul class="nav navbar-nav mr-auto">
                            <li class="active">
                                <a aria-expanded="false" role="button" href="/"> Ana Sayfa</a>
                            </li>
                        </ul>
                        <ul class="nav navbar-top-links navbar-right">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                @if (User.IsInRole("SuperAdmin") || User.IsInRole("Yetkili"))
                                {
                                    <li>
                                        <a asp-area="Panel" asp-controller="Home" asp-action="Index">
                                            <i class="fa fa-cogs"></i> Yönetim Paneline Git
                                        </a>
                                    </li>
                                }
                                <li>
                                    <form asp-area="Panel" asp-controller="Auth" asp-action="Logout" method="post" id="logoutForm" class="form-inline">
                                        <button type="submit" class="btn btn-link text-muted" style="padding-top: 15px; text-decoration: none;">
                                            <i class="fa fa-sign-out"></i> Çıkış Yap
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a asp-area="Panel" asp-controller="Auth" asp-action="Login">
                                        <i class="fa fa-sign-in"></i> Giriş Yap
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                </nav>
            </div>

            <div class="wrapper wrapper-content animated fadeInRight">
                <div class="container">
                    @RenderBody()
                </div>
            </div>

            @await Html.PartialAsync("_Footer")
        </div>
    </div>
    
    <a href="#" id="scrollToTop" class="btn btn-primary btn-circle btn-lg" style="position: fixed; bottom: 20px; right: 20px; display: none; z-index: 100; box-shadow: 0 2px 5px rgba(0,0,0,0.3);">
        <i class="fa fa-chevron-up"></i>
    </a>

    <!-- Mainly scripts -->
    <script src="~/js/jquery-3.1.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
    <script src="~/js/plugins/metisMenu/jquery.metisMenu.js"></script>
    <script src="~/js/plugins/slimscroll/jquery.slimscroll.min.js"></script>

    <!-- Custom and plugin javascript -->
    <script src="~/js/inspinia.js"></script>
    <script src="~/js/plugins/pace/pace.min.js"></script>
    
    <script>
        $(document).ready(function () {
            $(window).scroll(function () {
                if ($(this).scrollTop() > 100) {
                    $('#scrollToTop').fadeIn();
                } else {
                    $('#scrollToTop').fadeOut();
                }
            });

            $('#scrollToTop').click(function () {
                $("html, body").animate({ scrollTop: 0 }, 600);
                return false;
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
