@model Kilavuz.Web.Models.DocumentationViewModel
@{
    ViewData["Title"] = Model.ActivePage.Title;
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="row wrapper border-bottom white-bg page-heading m-b-md">
    <div class="col-md-12">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Ana Sayfa</a></li>
            <li class="breadcrumb-item">@Model.Application.Name</li>
            <li class="breadcrumb-item active">@Model.ActivePage.Title</li>
        </ol>
        <h2>
            @if (!string.IsNullOrEmpty(Model.Application.IconPath))
            {
                <i class="fa @Model.Application.IconPath"></i>
            }
            else
            {
                <i class="fa fa-book"></i>
            }
            @Model.Application.Name
        </h2>
    </div>
</div>

<div class="row">
    <!-- Sol Menü: Kategoriler ve Sayfalar -->
    <div class="col-md-3">
        @foreach (var catDto in Model.CategoriesWithPages)
        {
            <div class="ibox mb-3">
                <div class="ibox-title bg-light font-weight-bold" style="padding: 10px 15px; border-bottom: 1px solid #e7eaec;">
                    <i class="fa fa-folder-open-o"></i> @catDto.Category.Name
                </div>
                <div class="ibox-content p-0">
                    <div class="list-group list-group-flush">
                        @if (!catDto.Pages.Any())
                        {
                            <div class="list-group-item text-muted small">Sayfa yok</div>
                        }
                        else
                        {
                            @foreach (var p in catDto.Pages)
                            {
                                var isActive = p.Id == Model.ActivePage.Id;
                                <a href="/kilavuz/@Model.Application.Id/@catDto.Category.Id/@p.Id" 
                                   class="list-group-item list-group-item-action @(isActive ? "active font-weight-bold" : "")"
                                   style="@(isActive ? "background-color: #1ab394; border-color: #1ab394; color: white;" : "")">
                                    @if(p.AccessType == Kilavuz.Web.Domain.Enums.AccessType.Restricted)
                                    {
                                        <i class="fa fa-lock" style="@(isActive ? "color: white;" : "color: #f8ac59;")"></i> 
                                    }
                                    else
                                    {
                                        <i class="fa fa-file-text-o"></i> 
                                    }
                                    @p.Title
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Sağ İçerik: Seçilen Sayfa Detayı -->
    <div class="col-md-9">
        <div class="ibox">
            <div class="ibox-title">
                <h3 class="m-b-0">@Model.ActivePage.Title</h3>
                @if (!string.IsNullOrEmpty(Model.ActiveCategory.Description))
                {
                    <small class="text-muted">Kategori: @Model.ActiveCategory.Name - @Model.ActiveCategory.Description</small>
                }
            </div>
            <div class="ibox-content" style="min-height: 400px;">
                @Html.Raw(Model.ActivePage.ContentHtml)
            </div>
        </div>

        @* Ek Dosyalar *@
        @if (Model.ActiveAttachments.Any())
        {
            <div class="ibox m-t-md">
                <div class="ibox-title">
                    <h5><i class="fa fa-paperclip"></i> Ekler (@Model.ActiveAttachments.Count)</h5>
                </div>
                <div class="ibox-content">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Dosya Adı</th>
                                <th width="100">Boyut</th>
                                <th width="100">Yükleyen</th>
                                <th width="120"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var att in Model.ActiveAttachments)
                            {
                                <tr>
                                    <td><i class="fa fa-file-o"></i> @att.FileName</td>
                                    <td>@((att.FileSize / 1024.0).ToString("F1")) KB</td>
                                    <td>@att.UploadedAt.ToString("yyyy-MM-dd")</td>
                                    <td>
                                        <a href="/Attachment/Download/@att.Id"
                                           class="btn btn-default btn-xs">
                                            <i class="fa fa-download"></i> İndir
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
