@model IEnumerable<Kilavuz.Web.Domain.Entities.Application>
@using Kilavuz.Web.Domain.Enums
@{
    var title = ViewBag.DepartmentName != null ? ViewBag.DepartmentName + " Kılavuzları" : "Üniversite Kılavuzu";
    ViewData["Title"] = title;
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<div class="row m-b-lg m-t-lg">
    <div class="col-md-12 text-center">
        <h2>@title</h2>
        <p class="text-muted">Aşağıdan incelemek istediğiniz uygulamayı seçebilirsiniz.</p>

        <form action="/Search" method="get" class="form-inline m-t-md justify-content-center">
            <div class="input-group" style="max-width:500px; width:100%">
                <input id="searchInput" type="text" name="q" class="form-control form-control-lg"
                       placeholder="Bu kılavuzda ara..." autocomplete="off" />
                <div class="input-group-append">
                    <button class="btn btn-primary" type="submit"><i class="fa fa-search"></i></button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!Model.Any())
{
    <div class="row">
        <div class="col-md-12 text-center text-muted">
            <i class="fa fa-inbox fa-3x"></i>
            <p class="m-t-md">Bu bölümde henüz aktif bir uygulama bulunmamaktadır.</p>
        </div>
    </div>
}
else
{
    <div class="row">
        @foreach (var app in Model)
        {
            <div class="col-md-4 col-sm-6 mb-4 d-flex align-items-stretch">
                <div class="ibox w-100 mb-0">
                    <div class="ibox-content d-flex flex-column h-100" style="position:relative">
                        @if (app.AccessType == AccessType.Restricted)
                        {
                            <span class="label label-warning" style="position:absolute; top:10px; right:10px;">
                                <i class="fa fa-lock"></i> Kısıtlı
                            </span>
                        }
                        <h3 class="mb-2">
                            @if (!string.IsNullOrEmpty(app.IconPath))
                            {
                                <i class="fa @app.IconPath"></i>
                            }
                            else
                            {
                                <i class="fa fa-book"></i>
                            }
                            @app.Name
                        </h3>
                        <div class="flex-grow-1 mb-2">
                            @if (!string.IsNullOrEmpty(app.Description))
                            {
                                <p class="text-muted m-0">@app.Description</p>
                            }
                        </div>
                        <div>
                            <a href="/kilavuz/@app.Id" class="btn btn-primary btn-sm">
                                <i class="fa fa-arrow-right"></i> İncele
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
