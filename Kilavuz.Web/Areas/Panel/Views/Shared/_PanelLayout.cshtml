<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] | Yönetim Paneli</title>
    
    <link href="~/css/bootstrap.min.css" rel="stylesheet">
    <link href="~/font-awesome/css/font-awesome.css" rel="stylesheet">
    <link href="~/css/plugins/toastr/toastr.min.css" rel="stylesheet">
    <link href="~/css/plugins/sweetalert/sweetalert.css" rel="stylesheet">
    <link href="~/css/animate.css" rel="stylesheet">
    <link href="~/css/style.css" rel="stylesheet">
    <link href="~/css/site.css" rel="stylesheet">
    
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="">
    <div id="wrapper">
        <nav class="navbar-default navbar-static-side" role="navigation">
            <div class="sidebar-collapse">
                <ul class="nav metismenu" id="side-menu">
                    <li class="nav-header">
                        <div class="profile-element">
                            <a href="/Panel/Profile" title="Profilimi Düzenle">
                                <span class="block m-t-xs font-bold">@(User.Identity?.Name ?? "Kullanıcı")</span>
                                <span class="text-muted text-xs block">@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Yetkisiz") <i class="fa fa-edit"></i></span>
                            </a>
                        </div>
                        <div class="logo-element">KLV</div>
                    </li>
                    <li>
                        <a href="/Panel/Home"><i class="fa fa-dashboard"></i> <span class="nav-label">Gösterge Paneli</span></a>
                    </li>
                    <li>
                        <a href="/Panel/Application"><i class="fa fa-cubes"></i> <span class="nav-label">Uygulamalar</span></a>
                    </li>
                    @* Kategoriler ve Sayfalar doğrudan sidebar'dan erişilemiyor;
                       navigasyon: Uygulamalar → Kategorileri Yönet → Sayfaları Yönet *@
                    
                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <li>
                            <a href="/Panel/User"><i class="fa fa-users"></i> <span class="nav-label">Kullanıcı Yönetimi</span></a>
                        </li>
                        <li>
                            <a href="/Panel/Department"><i class="fa fa-building"></i> <span class="nav-label">Departmanlar</span></a>
                        </li>
                        <li>
                            <a href="/Panel/Log"><i class="fa fa-list-alt"></i> <span class="nav-label">Log Yönetimi</span></a>
                        </li>
                    }
                </ul>
            </div>
        </nav>

        <div id="page-wrapper" class="gray-bg">
            <div class="row border-bottom">
                <nav class="navbar navbar-static-top" role="navigation" style="margin-bottom: 0">
                    <div class="navbar-header">
                        <a class="navbar-minimalize minimalize-styl-2 btn btn-primary " href="#"><i class="fa fa-bars"></i> </a>
                    </div>
                    <ul class="nav navbar-top-links navbar-right">
                        <li>
                            <a href="/"><i class="fa fa-globe"></i> Kılavuza Dön</a>
                        </li>
                        <li>
                            <form id="logoutForm" asp-area="Panel" asp-controller="Auth" asp-action="Logout" method="post" style="display: none;"></form>
                            <a href="#" onclick="document.getElementById('logoutForm').submit(); return false;"><i class="fa fa-sign-out"></i> Çıkış Yap</a>
                        </li>
                    </ul>
                </nav>
            </div>
            
            <div class="row wrapper border-bottom white-bg page-heading">
                <div class="col-sm-12">
                    <h2>@ViewData["Title"]</h2>
                </div>
            </div>

            <div class="wrapper wrapper-content animated fadeInRight">
                @RenderBody()
            </div>
            
            <div class="footer">
                <div class="float-right">
                    Kurumsal Kullanım Kılavuzu Yönetim Sistemi
                </div>
                <div>
                    <strong>Copyright</strong> &copy; 2026
                </div>
            </div>
        </div>
    </div>
    
    <a href="#" id="scrollToTop" class="btn btn-primary btn-circle btn-lg" style="position: fixed; bottom: 20px; right: 20px; display: none; z-index: 100; box-shadow: 0 2px 5px rgba(0,0,0,0.3);">
        <i class="fa fa-chevron-up"></i>
    </a>

    <!-- Mainly scripts -->
    <script src="~/js/jquery-3.1.1.min.js"></script>
    <script src="~/js/popper.min.js"></script>
    <script src="~/js/bootstrap.js"></script>
    <script src="~/js/plugins/metisMenu/jquery.metisMenu.js"></script>
    <script src="~/js/plugins/slimscroll/jquery.slimscroll.min.js"></script>

    <!-- Custom and plugin javascript -->
    <script src="~/js/inspinia.js"></script>
    <script src="~/js/plugins/pace/pace.min.js"></script>
    
    <!-- SweetAlert & Toastr -->
    <script src="~/js/plugins/sweetalert/sweetalert.min.js"></script>
    <script src="~/js/plugins/toastr/toastr.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        $(document).ready(function() {
            toastr.options = {
                "closeButton": true,
                "progressBar": true,
                "positionClass": "toast-top-right",
                "timeOut": "5000"
            };

            @if (TempData["SuccessMessage"] != null)
            {
                <text>toastr.success(@Html.Raw(Json.Serialize(TempData["SuccessMessage"])));</text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>toastr.error(@Html.Raw(Json.Serialize(TempData["ErrorMessage"])));</text>
            }
            
            $(window).scroll(function () {
                if ($(this).scrollTop() > 100) {
                    $('#scrollToTop').fadeIn();
                } else {
                    $('#scrollToTop').fadeOut();
                }
            });

            $('#scrollToTop').click(function () {
                $("html, body").animate({ scrollTop: 0 }, 600);
                return false;
            });
        });
    </script>
</body>
</html>
