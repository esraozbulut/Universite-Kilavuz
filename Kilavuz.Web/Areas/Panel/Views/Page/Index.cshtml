@using Kilavuz.Web.Domain.Entities
@using Kilavuz.Web.Domain.Enums
@model IEnumerable<Page>
@{
    ViewData["Title"] = $"{ViewBag.CategoryName} - Sayfa Yönetimi";
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
    var isSuperAdmin = User.IsInRole("SuperAdmin");
    var categoryOwnerId = ViewBag.CategoryOwnerId as int? ?? 0;
    var canAddPage = isSuperAdmin || categoryOwnerId == currentUserId;
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox">
            <div class="ibox-title">
                <h5>
                    <a asp-controller="Application" asp-action="Index" class="text-muted">Uygulamalar</a>
                    <i class="fa fa-chevron-right fa-xs text-muted mx-1"></i>
                    <a asp-controller="Category" asp-action="Index" asp-route-applicationId="@ViewBag.ApplicationId" class="text-muted">@ViewBag.ApplicationName</a>
                    <i class="fa fa-chevron-right fa-xs text-muted mx-1"></i>
                    @ViewBag.CategoryName - Sayfalar
                </h5>
                <div class="ibox-tools">
                    <a asp-controller="Category" asp-action="Index" asp-route-applicationId="@ViewBag.ApplicationId" class="btn btn-default btn-xs">
                        <i class="fa fa-arrow-left"></i> Kategorilere Dön
                    </a>
                    @if (canAddPage)
                    {
                        <a asp-action="Create" asp-route-categoryId="@ViewBag.CategoryId" class="btn btn-primary btn-xs">
                            <i class="fa fa-plus"></i> Yeni Sayfa Ekle
                        </a>
                    }
                </div>
            </div>
            <div class="ibox-content">
                @if (!Model.Any())
                {
                    <div class="alert alert-info">
                        <i class="fa fa-info-circle"></i> Bu kategoriye henüz sayfa eklenmemiş.
                        @if (canAddPage)
                        {
                            <a asp-action="Create" asp-route-categoryId="@ViewBag.CategoryId">İlk sayfayı ekleyin.</a>
                        }
                    </div>
                }
                else
                {
                    <table class="table table-striped table-bordered table-hover dataTables-example">
                        <thead>
                            <tr>
                                <th>Sıra</th>
                                <th>Başlık</th>
                                <th>Erişim Tipi</th>
                                <th>Durum</th>
                                <th>Sıralama</th>
                                <th>Aksiyonlar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                var canModify = isSuperAdmin || item.CreatedByUserId == currentUserId;
                                <tr>
                                    <td>@item.SortOrder</td>
                                    <td>
                                        @item.Title
                                        @if (!string.IsNullOrEmpty(item.CoverImagePath))
                                        {
                                            <i class="fa fa-image text-muted ml-1" title="Kapak görseli var"></i>
                                        }
                                    </td>
                                    <td>
                                        @if (item.AccessType == AccessType.Public)
                                        {
                                            <span class="label label-primary">Herkese Açık</span>
                                        }
                                        else
                                        {
                                            <span class="label label-warning">Kısıtlı</span>
                                        }
                                    </td>
                                    <td>
                                        @if (item.IsActive)
                                        {
                                            <span class="label label-primary">Aktif</span>
                                        }
                                        else
                                        {
                                            <span class="label label-danger">Pasif</span>
                                        }
                                    </td>
                                    <td>
                                        @if (canModify)
                                        {
                                            <form asp-action="MoveUp" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-white btn-sm" title="Yukarı Taşı"><i class="fa fa-arrow-up"></i></button>
                                            </form>
                                            <form asp-action="MoveDown" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                <button type="submit" class="btn btn-white btn-sm" title="Aşağı Taşı"><i class="fa fa-arrow-down"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-white btn-sm" disabled title="Yalnızca sahibi sıralayabilir"><i class="fa fa-arrow-up"></i></button>
                                            <button class="btn btn-white btn-sm" disabled title="Yalnızca sahibi sıralayabilir"><i class="fa fa-arrow-down"></i></button>
                                        }
                                    </td>
                                    <td>
                                        @if (canModify)
                                        {
                                            @if (item.AccessType == Kilavuz.Web.Domain.Enums.AccessType.Restricted)
                                            {
                                                <a asp-controller="Permission" asp-action="Manage"
                                                   asp-route-contentType="Page"
                                                   asp-route-contentId="@item.Id"
                                                   class="btn btn-default btn-sm" title="Kısıtlı içerik — erişim izinlerini yönet">
                                                    <i class="fa fa-lock"></i> İzinleri Yönet
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-default btn-sm" disabled title="Yalnızca Kısıtlı içeriklerin izinleri yönetilebilir">
                                                    <i class="fa fa-unlock-alt"></i> İzinleri Yönet
                                                </button>
                                            }
                                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" class="delete-form">
                                                <button type="button" class="btn btn-danger btn-sm delete-btn">Sil</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <button class="btn btn-warning btn-sm" disabled title="Yalnızca sahibi düzenleyebilir"><i class="fa fa-lock"></i> Düzenle</button>
                                            <button class="btn btn-danger btn-sm" disabled title="Yalnızca sahibi silebilir"><i class="fa fa-lock"></i> Sil</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.delete-btn').on('click', function (e) {
                var form = $(this).closest('.delete-form');
                swal({
                    title: "Emin misiniz?",
                    text: "Bu sayfayı silmek istediğinize emin misiniz?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#DD6B55",
                    confirmButtonText: "Evet, sil!",
                    cancelButtonText: "Vazgeç",
                    closeOnConfirm: false
                }, function () {
                    form.submit();
                });
            });
        });
    </script>
}
