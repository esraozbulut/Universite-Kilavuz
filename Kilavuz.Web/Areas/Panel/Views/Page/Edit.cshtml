@using Kilavuz.Web.Domain.Entities
@using Kilavuz.Web.Domain.Enums
@model Page
@{
    ViewData["Title"] = "Sayfayı Düzenle";
    var attachments = ViewBag.Attachments as System.Collections.Generic.List<PageAttachment> ?? new System.Collections.Generic.List<PageAttachment>();
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox">
            <div class="ibox-title">
                <h5>Sayfayı Düzenle: <strong>@Model.Title</strong></h5>
                <div class="ibox-tools">
                    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-default btn-xs">
                        <i class="fa fa-arrow-left"></i> Sayfalar Listesine Dön
                    </a>
                </div>
            </div>
            <div class="ibox-content">
                <form asp-action="Edit" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="CategoryId" />
                    <input type="hidden" asp-for="SortOrder" />
                    <input type="hidden" asp-for="CreatedByUserId" />


                    <div asp-validation-summary="ModelOnly" class="alert alert-danger" style="display:none;"></div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Başlık <span class="text-danger">*</span></label>
                        <div class="col-sm-10">
                            <input asp-for="Title" class="form-control" />
                            <span asp-validation-for="Title" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">İçerik</label>
                        <div class="col-sm-10">
                            @* Sanitize edilmiş içerik — HtmlSanitizerService ile işlenmiş, Html.Raw kullanımı kasıtlı *@
                            <textarea id="contentEditor" asp-for="ContentHtml" class="form-control">@Html.Raw(Model.ContentHtml)</textarea>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Erişim Tipi</label>
                        <div class="col-sm-10">
                            <select asp-for="AccessType" class="form-control">
                                <option value="@AccessType.Public" selected="@(Model.AccessType == AccessType.Public)">Herkese Açık</option>
                                <option value="@AccessType.Restricted" selected="@(Model.AccessType == AccessType.Restricted)">Kısıtlı</option>
                            </select>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Durum</label>
                        <div class="col-sm-10 col-form-label">
                            <div class="custom-control custom-checkbox">
                                <input type="checkbox" asp-for="IsActive" class="custom-control-input" id="isActiveCheck" />
                                <label class="custom-control-label" for="isActiveCheck">Aktif (yayında)</label>
                            </div>
                        </div>
                    </div>

                    <div class="hr-line-dashed"></div>

                    <div class="form-group row">
                        <div class="col-sm-10 offset-sm-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="fa fa-save"></i> Güncelle
                            </button>
                            <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-default ml-1">Vazgeç</a>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* ── Ek Dosyalar Bölümü ────────────────────────────────────────────────────── *@
<div class="row">
    <div class="col-lg-12">
        <div class="ibox">
            <div class="ibox-title">
                <h5>Ek Dosyalar</h5>
            </div>
            <div class="ibox-content">
                @if (attachments.Any())
                {
                    <table class="table table-striped table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>Dosya Adı</th>
                                <th>Boyut</th>
                                <th>Yüklenme Tarihi</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var att in attachments)
                            {
                                <tr>
                                    <td>
                                        <i class="fa fa-file-o"></i>
                                        <a asp-action="DownloadAttachment" asp-route-attachmentId="@att.Id">@att.FileName</a>
                                    </td>
                                    <td>@(att.FileSize / 1024) KB</td>
                                    <td>@att.UploadedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                    <td>
                                        <form asp-action="DeleteAttachment" asp-route-attachmentId="@att.Id" method="post" style="display:inline;" class="delete-attachment-form">
                                            <button type="button" class="btn btn-danger btn-xs delete-attachment-btn">
                                                <i class="fa fa-trash"></i> Sil
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted"><i class="fa fa-info-circle"></i> Henüz ek dosya yüklenmemiş.</p>
                }

                <hr />
                <h6>Yeni Dosya Ekle</h6>
                <form asp-action="UploadAttachment" asp-route-pageId="@Model.Id" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <input type="file" name="file" class="form-control" accept=".pdf,.docx,.xlsx,.zip,.jpg,.jpeg,.png,.gif" />
                        <div class="input-group-append">
                            <button type="submit" class="btn btn-success">
                                <i class="fa fa-upload"></i> Yükle
                            </button>
                        </div>
                    </div>
                    <small class="form-text text-muted">İzin verilen formatlar: PDF, DOCX, XLSX, ZIP, JPG, JPEG, PNG, GIF. Maksimum boyut: 10 MB.</small>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="https://cdn.ckeditor.com/ckeditor5/42.0.1/ckeditor5.css" />
    <style>
        .ck-editor__editable_inline {
            min-height: 400px;
        }
    </style>
}

@section Scripts {
    <script type="importmap">
        {
            "imports": {
                "ckeditor5": "https://cdn.ckeditor.com/ckeditor5/42.0.1/ckeditor5.js",
                "ckeditor5/": "https://cdn.ckeditor.com/ckeditor5/42.0.1/"
            }
        }
    </script>
    <script type="module">
        import {
            ClassicEditor,
            Essentials,
            Paragraph,
            Heading,
            Bold,
            Italic,
            Underline,
            Strikethrough,
            Font,
            Alignment,
            List,
            TodoList,
            Indent,
            IndentBlock,
            BlockQuote,
            HorizontalLine,
            Link,
            Image,
            ImageCaption,
            ImageResize,
            ImageStyle,
            ImageToolbar,
            ImageUpload,
            Table,
            TableToolbar,
            SourceEditing
        } from 'ckeditor5';
        import translations from 'ckeditor5/translations/tr.js';
        
        import { ContentFilePlugin } from '/js/ckeditor/content-file-plugin.js';

        // Custom plugin configuration variables
        window.contentFileUploadUrl = '@Url.Action("UploadContentFile", "Page", new { area = "Panel" })';
        window.pageCategoryId = '@Model.CategoryId';
        window.pageId = '@Model.Id';


        class MyUploadAdapter {
            constructor(loader) {
                this.loader = loader;
            }
            upload() {
                return this.loader.file
                    .then(file => new Promise((resolve, reject) => {
                        const data = new FormData();
                        data.append('file', file);
                        data.append('__RequestVerificationToken', document.querySelector('input[name="__RequestVerificationToken"]').value);

                        $.ajax({
                            url: '@Url.Action("UploadImage", "Page", new { area = "Panel" })',
                            type: 'POST',
                            data: data,
                            processData: false,
                            contentType: false,
                            success: function (response) {
                                resolve({ default: response.url });
                            },
                            error: function (xhr) {
                                let msg = 'Yükleme başarısız';
                                try {
                                    const json = JSON.parse(xhr.responseText);
                                    if (json.error && json.error.message) msg = json.error.message;
                                    else if (json.error) msg = json.error;
                                } catch(e) {}
                                reject(msg);
                            }
                        });
                    }));
            }
            abort() { }
        }

        function MyCustomUploadAdapterPlugin(editor) {
            editor.plugins.get('FileRepository').createUploadAdapter = (loader) => {
                return new MyUploadAdapter(loader);
            };
        }

        ClassicEditor.create(document.querySelector('#contentEditor'), {
            plugins: [
                Essentials, Paragraph, Heading, Bold, Italic, Underline, Strikethrough, 
                Font, Alignment, List, TodoList, Indent, IndentBlock, BlockQuote, 
                HorizontalLine, Link, Image, ImageCaption, ImageResize, ImageStyle, 
                ImageToolbar, ImageUpload, Table, TableToolbar, SourceEditing, 
                MyCustomUploadAdapterPlugin, ContentFilePlugin
            ],
            toolbar: {
                items: [
                    'undo', 'redo', '|',
                    'heading', '|',
                    'bold', 'italic', 'underline', 'strikethrough', '|',
                    'fontFamily', 'fontSize', 'fontColor', 'fontBackgroundColor', '|',
                    'alignment', '|',
                    'bulletedList', 'numberedList', 'todoList', 'outdent', 'indent', '|',
                    'blockQuote', 'insertTable', 'horizontalLine', '|',
                    'link', 'uploadImage', 'insertContentFile', '|',
                    'sourceEditing'
                ],
                shouldNotGroupWhenFull: true
            },
            language: 'tr',
            translations: [translations],
            image: {
                toolbar: [
                    'imageStyle:inline', 'imageStyle:block', 'imageStyle:side', '|',
                    'toggleImageCaption', 'imageTextAlternative', '|',
                    'resizeImage'
                ]
            },
            table: {
                contentToolbar: ['tableColumn', 'tableRow', 'mergeTableCells']
            }
        })
        .then(editor => {
            window.editor = editor;
            
            // Kaydetmeden önce textarea'yı kesin olarak güncelle
            $('form').not('.delete-attachment-form').on('submit', function () {
                var currentContent = editor.getData();
                $('#contentEditor').val(currentContent);
            });
            
            // Ek dosya silme onayı
            $('.delete-attachment-btn').on('click', function () {
                var form = $(this).closest('.delete-attachment-form');
                if (typeof swal !== 'undefined') {
                    swal({
                        title: "Emin misiniz?",
                        text: "Bu dosyayı silmek istediğinize emin misiniz?",
                        type: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#DD6B55",
                        confirmButtonText: "Evet, sil!",
                        cancelButtonText: "Vazgeç",
                        closeOnConfirm: false
                    }, function () {
                        form.submit();
                    });
                } else {
                    if (confirm("Bu dosyayı silmek istediğinize emin misiniz?")) {
                        form.submit();
                    }
                }
            });
        })
        .catch(error => {
            console.error(error);
        });
    </script>
}
