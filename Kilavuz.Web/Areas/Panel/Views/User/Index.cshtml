@model IEnumerable<Kilavuz.Web.Areas.Panel.Models.UserViewModel>
@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Sistem Kullanıcıları</h5>
                <div class="ibox-tools">
                    <a asp-action="Create" class="btn btn-primary btn-xs"><i class="fa fa-user-plus"></i> Yeni Kullanıcı Ekle</a>
                </div>
            </div>
            <div class="ibox-content">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Kullanıcı Adı</th>
                            <th>E-Posta</th>
                            <th>Roller</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>@user.Id</td>
                                <td>@user.UserName</td>
                                <td>@user.Email</td>
                                <td>
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="label label-info">@role</span>
                                    }
                                </td>
                                <td>
                                    @if (user.IsActive)
                                    {
                                        <span class="label label-primary">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@user.Id" class="btn btn-warning btn-sm"><i class="fa fa-pencil"></i> Düzenle</a>
                                    
                                    <form asp-action="ToggleActive" asp-route-id="@user.Id" method="post" style="display:inline;" class="toggle-form">
                                        @if (user.IsActive)
                                        {
                                            <button type="button" class="btn btn-danger btn-sm toggle-btn" data-action="Pasifleştirmek"><i class="fa fa-ban"></i> Pasifleştir</button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-primary btn-sm toggle-btn" data-action="Aktifleştirmek"><i class="fa fa-check"></i> Aktifleştir</button>
                                        }
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.toggle-btn').on('click', function (e) {
                var form = $(this).closest('.toggle-form');
                var actionText = $(this).data("action");
                swal({
                    title: "Emin misiniz?",
                    text: "Bu hesabı " + actionText + " istediğinize emin misiniz?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#DD6B55",
                    confirmButtonText: "Evet, Onayla!",
                    cancelButtonText: "Vazgeç",
                    closeOnConfirm: false
                }, function () {
                    form.submit();
                });
            });
        });
    </script>
}
