@model Kilavuz.Web.Areas.Panel.Models.UserCreateViewModel
@{
    ViewData["Title"] = "Yeni Kullanıcı Ekle";
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Kullanıcı Bilgileri</h5>
                <div class="ibox-tools">
                    <a asp-action="Index" class="btn btn-default btn-xs">Geri Dön</a>
                </div>
            </div>
            <div class="ibox-content">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    
                    <div class="form-group row">
                        <label asp-for="UserName" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="UserName" class="form-control" autocomplete="off" />
                            <span asp-validation-for="UserName" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Email" class="form-control" autocomplete="off" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="Password" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="SelectedRoleIds" class="col-sm-2 col-form-label"></label>
                        <div class="col-sm-10">
                            <select asp-for="SelectedRoleIds" asp-items="Model.AvailableRoles" class="form-control" multiple="multiple" size="3"></select>
                            <span asp-validation-for="SelectedRoleIds" class="text-danger"></span>
                            <small class="form-text text-muted">Ctrl (veya Cmd) tuşuna basılı tutarak birden fazla rol seçebilirsiniz.</small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-sm-10 offset-sm-2">
                            <div class="i-checks">
                                <label> <input asp-for="IsActive" type="checkbox"> <i></i> Aktif Hesap </label>
                            </div>
                        </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                    <div class="form-group row">
                        <div class="col-sm-4 offset-sm-2">
                            <a asp-action="Index" class="btn btn-white btn-sm">İptal</a>
                            <button class="btn btn-primary btn-sm" type="submit">Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
