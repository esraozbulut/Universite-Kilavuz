@using Kilavuz.Web.Domain.Entities
@model IEnumerable<Application>
@{
    ViewData["Title"] = "Uygulama Yönetimi";
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
    var isSuperAdmin = User.IsInRole("SuperAdmin");
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Uygulamalar</h5>
                <div class="ibox-tools">
                    <a asp-action="Create" class="btn btn-primary btn-xs">Yeni Uygulama Ekle</a>
                </div>
            </div>
            <div class="ibox-content">
                <table class="table table-striped table-bordered table-hover dataTables-example">
                    <thead>
                        <tr>
                            <th>Sıra</th>
                            <th>İkon</th>
                            <th>Ad</th>
                            <th>Açıklama</th>
                            <th>Erişim Tipi</th>
                            <th>Sabit</th>
                            <th>Durum</th>
                            <th>Sıralama</th>
                            <th>Aksiyonlar</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.SortOrder</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.IconPath))
                                    {
                                        <i class="@item.IconPath"></i>
                                    }
                                </td>
                                <td>@item.Name</td>
                                <td>@item.Description</td>
                                <td>
                                    @if (item.AccessType == Kilavuz.Web.Domain.Enums.AccessType.Public)
                                    {
                                        <span class="label label-primary">Herkese Açık</span>
                                    }
                                    else
                                    {
                                        <span class="label label-warning">Kısıtlı</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsPinned)
                                    {
                                        <span class="label label-success"><i class="fa fa-thumb-tack"></i> Evet</span>
                                    }
                                    else
                                    {
                                        <span class="label label-default">Hayır</span>
                                    }
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="label label-primary">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="label label-danger">Pasif</span>
                                    }
                                </td>
                                @{
                                    var canModify = isSuperAdmin || item.CreatedByUserId == currentUserId;
                                }
                                <td>
                                    @if (canModify)
                                    {
                                        <form asp-action="MoveUp" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-white btn-sm" title="Yukarı Taşı"><i class="fa fa-arrow-up"></i></button>
                                        </form>
                                        <form asp-action="MoveDown" asp-route-id="@item.Id" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-white btn-sm" title="Aşağı Taşı"><i class="fa fa-arrow-down"></i></button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-white btn-sm" disabled title="Yalnızca sahibi sıralayabilir"><i class="fa fa-arrow-up"></i></button>
                                        <button class="btn btn-white btn-sm" disabled title="Yalnızca sahibi sıralayabilir"><i class="fa fa-arrow-down"></i></button>
                                    }
                                </td>
                                <td>
                                    <a asp-controller="Category" asp-action="Index" asp-route-applicationId="@item.Id" class="btn btn-info btn-sm">Kategorileri Yönet</a>
                                    @if (canModify)
                                    {
                                        @if (User.IsInRole("SuperAdmin"))
                                        {
                                            if (item.AccessType == Kilavuz.Web.Domain.Enums.AccessType.Restricted)
                                            {
                                                <a asp-controller="Permission" asp-action="Manage"
                                                   asp-route-contentType="Application"
                                                   asp-route-contentId="@item.Id"
                                                   class="btn btn-default btn-sm" title="Kısıtlı içerik — erişim izinlerini yönet">
                                                    <i class="fa fa-lock"></i> İzinleri Yönet
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-default btn-sm" disabled title="Yalnızca Kısıtlı içeriklerin izinleri yönetilebilir">
                                                    <i class="fa fa-unlock-alt"></i> İzinleri Yönet
                                                </button>
                                            }
                                        }
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Düzenle</a>
                                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;" class="delete-form">
                                            <button type="button" class="btn btn-danger btn-sm delete-btn">Sil</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <button class="btn btn-warning btn-sm" disabled title="Yalnızca sahibi düzenliyebilir"><i class="fa fa-lock"></i> Düzenle</button>
                                        <button class="btn btn-danger btn-sm" disabled title="Yalnızca sahibi silebilir"><i class="fa fa-lock"></i> Sil</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('.delete-btn').on('click', function (e) {
                var form = $(this).closest('.delete-form');
                swal({
                    title: "Emin misiniz?",
                    text: "Bu uygulamayı silmek istediğinize emin misiniz?",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#DD6B55",
                    confirmButtonText: "Evet, sil!",
                    cancelButtonText: "Vazgeç",
                    closeOnConfirm: false
                }, function () {
                    form.submit();
                });
            });
        });
    </script>
}
