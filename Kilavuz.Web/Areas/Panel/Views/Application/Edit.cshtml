@using Kilavuz.Web.Domain.Entities
@using Kilavuz.Web.Domain.Enums
@model Application
@{
    ViewData["Title"] = "Uygulama Düzenle";
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Uygulama Bilgileri</h5>
            </div>
            <div class="ibox-content">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Uygulama Adı</label>
                        <div class="col-sm-10">
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Kılavuz / Departman</label>
                        <div class="col-sm-10">
                            @if (User.IsInRole("SuperAdmin"))
                            {
                                <select asp-for="DepartmentId" class="form-control">
                                    <option value="">-- Üniversite Kılavuzu --</option>
                                    @if (ViewBag.Departments != null)
                                    {
                                        foreach (var dept in ViewBag.Departments as IEnumerable<Kilavuz.Web.Domain.Entities.Department>)
                                        {
                                            <option value="@dept.Id">@dept.Name</option>
                                        }
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="hidden" asp-for="DepartmentId" />
                                <input type="text" class="form-control" value="@(Model.DepartmentId.HasValue && ViewBag.Departments != null ? ((IEnumerable<Kilavuz.Web.Domain.Entities.Department>)ViewBag.Departments).FirstOrDefault(d => d.Id == Model.DepartmentId)?.Name : "Üniversite Kılavuzu")" readonly disabled />
                            }
                        </div>
                    </div>
                    
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Açıklama</label>
                        <div class="col-sm-10">
                            <textarea asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">İkon (FontAwesome Class)</label>
                        <div class="col-sm-10">
                            <input asp-for="IconPath" class="form-control" />
                            <span asp-validation-for="IconPath" class="text-danger"></span>
                        </div>
                    </div>

                    @if (User.IsInRole("SuperAdmin"))
                    {
                        <div class="form-group row">
                            <div class="col-sm-2">Sabitleme</div>
                            <div class="col-sm-10">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" asp-for="IsPinned">
                                    <label class="form-check-label" asp-for="IsPinned">
                                        Kılavuz Ana Sayfaya Sabitle
                                    </label>
                                </div>
                            </div>
                        </div>
                    }

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Erişim Tipi</label>
                        <div class="col-sm-10">
                            <select asp-for="AccessType" class="form-control" asp-items="Html.GetEnumSelectList<AccessType>()"></select>
                            <span asp-validation-for="AccessType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Durum</label>
                        <div class="col-sm-10">
                            <div class="i-checks">
                                <label> <input asp-for="IsActive" type="checkbox"> <i></i> Aktif </label>
                            </div>
                        </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                    <div class="form-group row">
                        <div class="col-sm-4 col-sm-offset-2">
                            <a asp-action="Index" class="btn btn-white btn-sm">İptal</a>
                            <button class="btn btn-primary btn-sm" type="submit">Güncelle</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
