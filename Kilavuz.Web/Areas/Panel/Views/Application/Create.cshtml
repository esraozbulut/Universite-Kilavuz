@using Kilavuz.Web.Domain.Entities
@using Kilavuz.Web.Domain.Enums
@model Application
@{
    ViewData["Title"] = "Yeni Uygulama Ekle";
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Uygulama Bilgileri</h5>
            </div>
            <div class="ibox-content">
                <form asp-action="Create" method="post">
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Uygulama Adı</label>
                        <div class="col-sm-10">
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Açıklama</label>
                        <div class="col-sm-10">
                            <textarea asp-for="Description" class="form-control"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">İkon (FontAwesome Class)</label>
                        <div class="col-sm-10">
                            <input asp-for="IconPath" class="form-control" placeholder="Örnek: fa fa-laptop" />
                            <span asp-validation-for="IconPath" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <div class="col-sm-2">Sabitleme</div>
                        <div class="col-sm-10">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" asp-for="IsPinned">
                                <label class="form-check-label" asp-for="IsPinned">
                                    Kılavuz Ana Sayfaya Sabitle
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Erişim Tipi</label>
                        <div class="col-sm-10">
                            <select asp-for="AccessType" class="form-control" asp-items="Html.GetEnumSelectList<AccessType>()"></select>
                            <span asp-validation-for="AccessType" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Sıra No</label>
                        <div class="col-sm-10">
                            <input asp-for="SortOrder" type="number" class="form-control" value="0" />
                            <span asp-validation-for="SortOrder" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Durum</label>
                        <div class="col-sm-10">
                            <div class="i-checks">
                                <label> <input asp-for="IsActive" type="checkbox" checked> <i></i> Aktif </label>
                            </div>
                        </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                    <div class="form-group row">
                        <div class="col-sm-4 col-sm-offset-2">
                            <a asp-action="Index" class="btn btn-white btn-sm">İptal</a>
                            <button class="btn btn-primary btn-sm" type="submit">Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
