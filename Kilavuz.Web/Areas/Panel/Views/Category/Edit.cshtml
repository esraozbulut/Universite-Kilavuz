@model Kilavuz.Web.Domain.Entities.Category
@{
    ViewData["Title"] = "Kategori Düzenle";
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Kategori Düzenle</h5>
            </div>
            <div class="ibox-content">
                <form asp-action="Edit" method="post">
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="ApplicationId" />
                    <input type="hidden" asp-for="CreatedByUserId" />
                    <input type="hidden" asp-for="CreatedAt" />
                    <input type="hidden" asp-for="SortOrder" />

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Ad</label>
                        <div class="col-sm-10">
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="hr-line-dashed"></div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Açıklama</label>
                        <div class="col-sm-10">
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="hr-line-dashed"></div>

                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label">Durum</label>
                        <div class="col-sm-10">
                            <div class="i-checks">
                                <label> <input asp-for="IsActive" type="checkbox"> <i></i> Aktif </label>
                            </div>
                        </div>
                    </div>
                    <div class="hr-line-dashed"></div>

                    <div class="form-group row">
                        <div class="col-sm-4 col-sm-offset-2">
                            <a asp-action="Index" asp-route-applicationId="@Model.ApplicationId" class="btn btn-white btn-sm">İptal</a>
                            <button class="btn btn-primary btn-sm" type="submit">Değişiklikleri Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
