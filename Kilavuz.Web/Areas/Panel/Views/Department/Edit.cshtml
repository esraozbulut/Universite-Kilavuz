@model Kilavuz.Web.Areas.Panel.Models.DepartmentEditViewModel
@{
    ViewData["Title"] = "Departman Düzenle";
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Departman Düzenle: @Model.Name</h5>
                <div class="ibox-tools">
                    <a href="/Panel/Department" class="btn btn-white btn-xs">İptal</a>
                </div>
            </div>
            <div class="ibox-content">
                <form method="post" action="/Panel/Department/Edit">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label" asp-for="Name"></label>
                        <div class="col-sm-10">
                            <input asp-for="Name" class="form-control">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label" asp-for="Slug"></label>
                        <div class="col-sm-10">
                            <input asp-for="Slug" class="form-control">
                            <small class="form-text text-muted">Dikkat: Bu alanın değiştirilmesi, departmanın public URL'sini de değiştirecektir.</small>
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label" asp-for="Description"></label>
                        <div class="col-sm-10">
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>
                    
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label" asp-for="IsActive"></label>
                        <div class="col-sm-10">
                            <div class="i-checks"><label> <input type="checkbox" asp-for="IsActive"> <i></i> Aktif </label></div>
                        </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                    <div class="form-group row">
                        <div class="col-sm-4 col-sm-offset-2">
                            <button class="btn btn-primary btn-sm" type="submit">Değişiklikleri Kaydet</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
