@model Kilavuz.Web.Areas.Panel.Models.DepartmentCreateViewModel
@{
    ViewData["Title"] = "Yeni Departman";
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Yeni Departman Oluştur</h5>
                <div class="ibox-tools">
                    <a href="/Panel/Department" class="btn btn-white btn-xs">İptal</a>
                </div>
            </div>
            <div class="ibox-content">
                <form method="post" action="/Panel/Department/Create">
                    @Html.AntiForgeryToken()
                    
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label" asp-for="Name"></label>
                        <div class="col-sm-10">
                            <input asp-for="Name" class="form-control" id="Name">
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label" asp-for="Slug"></label>
                        <div class="col-sm-10">
                            <input asp-for="Slug" class="form-control" id="Slug">
                            <small class="form-text text-muted">Örn: bilgi-islem, insan-kaynaklari. Sadece küçük harf, rakam ve tire kullanın.</small>
                            <span asp-validation-for="Slug" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="form-group row">
                        <label class="col-sm-2 col-form-label" asp-for="Description"></label>
                        <div class="col-sm-10">
                            <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="hr-line-dashed"></div>
                    <div class="form-group row">
                        <div class="col-sm-4 col-sm-offset-2">
                            <button class="btn btn-primary btn-sm" type="submit">Oluştur</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Basit Slug Generator (Client-side)
        $(document).ready(function() {
            $('#Name').on('keyup', function() {
                var title = $(this).val();
                var slug = title.toLowerCase()
                    .replace(/ğ/g, 'g')
                    .replace(/ü/g, 'u')
                    .replace(/ş/g, 's')
                    .replace(/ı/g, 'i')
                    .replace(/ö/g, 'o')
                    .replace(/ç/g, 'c')
                    .replace(/[^a-z0-9-]/g, '-')
                    .replace(/-+/g, '-')
                    .replace(/^-|-$/g, '');
                $('#Slug').val(slug);
            });
        });
    </script>
}
