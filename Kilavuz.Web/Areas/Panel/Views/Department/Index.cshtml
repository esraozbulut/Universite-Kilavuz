@model IEnumerable<Kilavuz.Web.Domain.Entities.Department>
@{
    ViewData["Title"] = "Departmanlar";
    var userCounts = ViewBag.UserCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="row">
    <div class="col-lg-12">
        <div class="ibox ">
            <div class="ibox-title">
                <h5>Departman Listesi</h5>
                <div class="ibox-tools">
                    <a href="/Panel/Department/Create" class="btn btn-primary btn-xs">Yeni Departman Ekle</a>
                </div>
            </div>
            <div class="ibox-content">
                <table class="table table-striped table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Departman Adı</th>
                            <th>Slug</th>
                            <th>Durum</th>
                            <th>Yetkili Sayısı</th>
                            <th>Oluşturulma</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Id</td>
                                <td>@item.Name</td>
                                <td><span class="text-muted">@item.Slug</span></td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge badge-primary">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">Pasif</span>
                                    }
                                </td>
                                <td>@(userCounts.ContainsKey(item.Id) ? userCounts[item.Id] : 0)</td>
                                <td>@item.CreatedAt.ToShortDateString()</td>
                                <td>
                                    <a href="/Panel/Department/Edit/@item.Id" class="btn btn-white btn-sm"><i class="fa fa-pencil"></i> Düzenle</a>
                                    <a href="/Panel/Department/Users/@item.Id" class="btn btn-info btn-sm"><i class="fa fa-users"></i> Yetkililer</a>
                                    <form action="/Panel/Department/Delete/@item.Id" method="post" style="display:inline;" onsubmit="return confirm('Bu departmanı silmek (pasife çekmek) istediğinize emin misiniz?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-danger btn-sm"><i class="fa fa-trash"></i> Sil</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
